@inherits CancellableComponentBase
@inject IAccountService AccountService

<EditForm Model="_request" OnValidSubmit="SubmitAsync" FormName="remove-shares">
    <DataAnnotationsValidator />
    <ErrorAlert Error="_error" />

    <p>
        You hold <strong>@Holding.Quantity.ToString(DisplayFormats.Quantity, CultureInfo.CurrentCulture)</strong>
        shares of <span class="symbol">@Holding.Symbol</span>.
    </p>

    <div class="form-field">
        <label for="remove-quantity">Shares to sell</label>
        <div class="input-group">
            <InputNumber id="remove-quantity" class="input" @bind-Value="_request.Quantity" step="any" min="0" />
            <button type="button" class="btn btn-secondary" @onclick="() => _request.Quantity = Holding.Quantity">All</button>
        </div>
        <ValidationMessage For="() => _request.Quantity" />
    </div>
    <p class="hint">Sale proceeds are not added to the cash balance automatically. Record a deposit if the cash stays in this account.</p>

    <div class="form-actions">
        <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
        <button type="submit" class="btn btn-danger" disabled="@_isSaving">Sell shares</button>
    </div>
</EditForm>

@code {
    private RemoveSharesRequest _request = new();
    private Error? _error;
    private bool _isSaving;

    [Parameter, EditorRequired]
    public Guid AccountId { get; set; }

    [Parameter, EditorRequired]
    public HoldingModel Holding { get; set; } = default!;

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.Equals(_request.Symbol, Holding.Symbol, StringComparison.Ordinal))
        {
            _request = new RemoveSharesRequest { Symbol = Holding.Symbol };
        }
    }

    private async Task SubmitAsync()
    {
        _isSaving = true;
        try
        {
            var result = await AccountService.RemoveSharesAsync(AccountId, _request, ComponentToken);
            _error = result.Error;
            if (result.IsSuccess)
            {
                await OnSaved.InvokeAsync();
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}
