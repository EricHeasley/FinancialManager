@inherits CancellableComponentBase
@inject IAccountService AccountService
@inject IQuoteService QuoteService

<EditForm Model="_request" OnValidSubmit="SubmitAsync" FormName="add-shares">
    <DataAnnotationsValidator />
    <ErrorAlert Error="_error" />

    <div class="form-field">
        <label for="add-symbol">Symbol</label>
        <div class="input-group">
            <InputText id="add-symbol" class="input input-symbol" @bind-Value="_request.Symbol" placeholder="e.g. AAPL" />
            <button type="button" class="btn btn-secondary" @onclick="LookupPriceAsync" disabled="@_isLookingUp">
                <Icon Name="IconName.Search" Size="16" /> Use current price
            </button>
        </div>
        @if (_quote is not null)
        {
            <div class="hint">@_quote.Name · @_quote.Price.ToString(DisplayFormats.Price, CultureInfo.CurrentCulture) @_quote.Currency</div>
        }
        <ValidationMessage For="() => _request.Symbol" />
    </div>

    <div class="form-grid">
        <div class="form-field">
            <label for="add-quantity">Shares</label>
            <InputNumber id="add-quantity" class="input" @bind-Value="_request.Quantity" step="any" min="0" />
            <ValidationMessage For="() => _request.Quantity" />
        </div>
        <div class="form-field">
            <label for="add-price">Price per share</label>
            <InputNumber id="add-price" class="input" @bind-Value="_request.PricePerShare" step="any" min="0" />
            <ValidationMessage For="() => _request.PricePerShare" />
        </div>
    </div>
    <p class="hint">If you already hold this symbol, the shares are merged and the average cost is recalculated.</p>

    <div class="form-actions">
        <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
        <button type="submit" class="btn btn-primary" disabled="@_isSaving">Add shares</button>
    </div>
</EditForm>

@code {
    private readonly AddSharesRequest _request = new();
    private StockQuote? _quote;
    private Error? _error;
    private bool _isSaving;
    private bool _isLookingUp;

    [Parameter, EditorRequired]
    public Guid AccountId { get; set; }

    /// <summary>Optional pre-filled symbol, e.g. when adding from the stock lookup page.</summary>
    [Parameter]
    public string? Symbol { get; set; }

    /// <summary>Optional pre-filled price per share.</summary>
    [Parameter]
    public decimal? PricePerShare { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override void OnInitialized()
    {
        _request.Symbol = Symbol ?? string.Empty;
        _request.PricePerShare = PricePerShare ?? decimal.Zero;
    }

    private async Task LookupPriceAsync()
    {
        _isLookingUp = true;
        try
        {
            var result = await QuoteService.GetQuoteAsync(new QuoteLookupRequest { Symbol = _request.Symbol }, ComponentToken);
            _error = result.Error;
            _quote = result.IsSuccess ? result.Value : null;
            if (_quote is not null)
            {
                _request.Symbol = _quote.Symbol;
                _request.PricePerShare = _quote.Price;
            }
        }
        finally
        {
            _isLookingUp = false;
        }
    }

    private async Task SubmitAsync()
    {
        _isSaving = true;
        try
        {
            var result = await AccountService.AddSharesAsync(AccountId, _request, ComponentToken);
            _error = result.Error;
            if (result.IsSuccess)
            {
                await OnSaved.InvokeAsync();
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}
