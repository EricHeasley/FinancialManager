{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FinancialManager": "Data Source=App_Data/financialmanager.db"
  },
  "Database": {
    "ConnectionStringName": "FinancialManager",
    "ApplyMigrationsOnStartup": true
  },
  "Display": {
    "CultureName": "en-US"
  },
  "Quotes": {
    "MaxConcurrentRequests": 4,
    "Cache": {
      "DurationSeconds": 60
    },
    "YahooFinance": {
      "BaseUrl": "https://query1.finance.yahoo.com/",
      "ChartPath": "v8/finance/chart",
      "ChartQuery": "interval=1d&range=1d",
      "UserAgent": "Mozilla/5.0 (compatible; FinancialManager/1.0)"
    },
    "Resilience": {
      "AttemptTimeout": {
        "Timeout": "00:00:05"
      },
      "TotalRequestTimeout": {
        "Timeout": "00:00:15"
      },
      "Retry": {
        "MaxRetryAttempts": 2,
        "Delay": "00:00:00.500"
      },
      "CircuitBreaker": {
        "SamplingDuration": "00:00:30"
      }
    }
  }
}
